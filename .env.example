# Copy to .env and fill in:  cp .env.example .env

# ---------------- Search ----------------
# duckduckgo (free, no key) | serpapi (Google results, needs key)
SEARCH_PROVIDER=duckduckgo
SERPAPI_API_KEY=
# Fetch each result page so the LLM sees real content, not just the snippet
FETCH_PAGES=true
PAGE_CHAR_LIMIT=6000
REQUEST_TIMEOUT=15

# ---------------- LLM -------------------
# anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Leave blank for provider default (anthropic: claude-sonnet-5-5, openai: gpt-4o-mini, ollama: llama3.1)
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (Groq, Together, LM Studio, vLLM...)
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_HOST=http://localhost:11434

# ---------------- Notifications ("ding") ----------------
# Configure one or more. With none set, alerts are printed to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ---------------- Storage ----------------
DATABASE_PATH=leads.db
CRITERIA_PATH=criteria.yaml
